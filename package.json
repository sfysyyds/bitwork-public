{
  "name": "bitwork-public-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "snapshot": "node scripts/snapshot-public-resources.mjs",
    "check:snapshot": "node scripts/check-public-snapshot.mjs",
    "build": "node scripts/generate-pages.mjs && vite build && node scripts/verify-dist.mjs",
    "check:publish": "node scripts/preflight.mjs",
    "publish:build": "npm run check:publish && npm run build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.0.16",
    "esbuild": "0.28.1"
  }
}
